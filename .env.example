# Copy to .env (which Git ignores) and fill in real values locally.
# Never commit .env or paste a real key into chat, logs or screenshots.

# Which model provider to use: ollama (local, default) or openrouter (cloud).
LLM_PROVIDER=ollama

# OpenRouter (OpenAI-compatible API). Leave the key empty here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Large-protocol analysis (optional overrides; defaults support ~180-page PDFs)
# CTAI_PROTOCOL_CHUNK_TOKENS=1560
# CTAI_PROTOCOL_CHUNK_CHARS=5000
# CTAI_PROTOCOL_CHUNK_OVERLAP_CHARS=400
# CTAI_PROTOCOL_MAX_INPUT_CHARS=2000000
# CTAI_PROTOCOL_MAX_CALLS=450
# CTAI_PROTOCOL_PASS_RETRIES=1
# Timeouts (three different knobs — they do not substitute for each other):
#
# 1) Protocol Analysis wall-clock budget ONLY (chunked extraction). Does NOT
#    limit Patient Guide / statement generation. Default 1800 (30 min).
#    For large protocols prefer 3600 (60 min):
# CTAI_ANALYSIS_MAX_SECONDS=3600
#
# 2) Per-model-HTTP-request timeout (OpenRouter/Ollama). Default 600 (10 min).
#    Applies to each individual analysis or statement call, not the whole job.
# CTAI_MODEL_TIMEOUT_SECONDS=600
#
# 3) Patient Guide generation has no overall CTAI_* wall-clock budget today.
#    Statements are written concurrently (default 4) and saved to SQLite as
#    they finish; Stop/Resume skips completed ids. Do not restart Streamlit
#    while a job is progressing.
# CTAI_GUIDE_WORKERS=4
