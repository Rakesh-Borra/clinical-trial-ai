# Copy to .env (which Git ignores) and fill in real values locally.
# Never commit .env or paste a real key into chat, logs or screenshots.

# Which model provider to use: ollama (local, default) or openrouter (cloud).
LLM_PROVIDER=ollama

# OpenRouter (OpenAI-compatible API). Leave the key empty here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
