# Copy to .env (Git ignores .env). Never commit real keys.

# Model provider: ollama (local, default) or openrouter (cloud).
# There is no automatic fallback between providers.
LLM_PROVIDER=ollama

# --- OpenRouter (required when LLM_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini

# --- Ollama (used when LLM_PROVIDER=ollama) ---
# Install Ollama, then: ollama pull qwen3:4b
# Optional: CTAI_NUM_CTX=16384

# --- Optional timeouts / limits ---
# CTAI_ANALYSIS_MAX_SECONDS=1800
# CTAI_MODEL_TIMEOUT_SECONDS=600
# CTAI_GUIDE_WORKERS=4

# Patient Chat optional LLM rewording (default off). Uses the same LLM_PROVIDER.
# CTAI_CHAT_LLM=0
